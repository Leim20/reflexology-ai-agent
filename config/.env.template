# ============================================================================
# CHAT AGENT TEMPLATE - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env in the project root and fill in your actual values
# NEVER commit .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# OpenAI API Configuration
# ----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=  # <-- put your OpenAI API key here

# ----------------------------------------------------------------------------
# WhatsApp Integration (Whapi)
# ----------------------------------------------------------------------------
# Get these values from: https://whapi.cloud after creating an account
WHAPI_API_TOKEN=  # <-- put your Whapi API token here
WHAPI_CHANNEL_ID=  # <-- put your Whapi channel ID here

# ----------------------------------------------------------------------------
# Webhook Configuration
# ----------------------------------------------------------------------------
# Your public webhook URL for receiving WhatsApp messages
# Format: https://your-domain.com/webhook/whapi or http://your-ip:5000/webhook/whapi
WEBHOOK_URL=  # <-- put your webhook URL here

# ----------------------------------------------------------------------------
# Flask Configuration
# ----------------------------------------------------------------------------
# Secret key for Flask sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=  # <-- put your Flask secret key here

# Flask environment (development or production)
FLASK_ENV=development

# Flask debug mode (True or False)
FLASK_DEBUG=True
