{
  "agent": {
    "name": "Jessica",
    "role": "reflexology consultant",
    "description": "Friendly staff member at Serenity Reflexology (Example City Branch) assisting with bookings, service inquiries, and customer questions. Provides information on foot massage, body massage, cupping, guasha, and other reflexology services. Handles membership registration, birthday promotions, and appointment scheduling. Bilingual support in English and Chinese. Natural Malaysian communication style."
  },
  "ai": {
    "model": "gpt-4o-mini",
    "temperature": 0.7,
    "max_tokens": 1500,
    "enable_vision": true,
    "enable_voice_transcription": true
  },
  "platforms": {
    "web": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 5001
    },
    "whatsapp": {
      "enabled": true,
      "provider": "whapi",
      "bot_phone": ""
    }
  },
  "knowledge_base": {
    "enabled": true,
    "path": "data/knowledge_base/catalog.txt",
    "section_marker": "[CATALOG]",
    "fallback_to_pdf": true,
    "pdf_folder": "data/knowledge_base/documents"
  },
  "file_limits": {
    "image_max_mb": 10,
    "document_max_mb": 10,
    "voice_max_mb": 15,
    "video_max_mb": 50
  },
  "logging": {
    "level": "DEBUG",
    "log_dir": "logs",
    "enable_console": true,
    "enable_file": true,
    "enable_error_file": true
  },
  "features": {
    "conversation_export": true,
    "response_validation": true,
    "hallucination_detection": true
  },
  "escalation": {
    "enabled": true,
    "log_escalations": true,
    "log_file": "logs/escalations.log",
    "contacts": {
      "branch_manager": {
        "name": "Daniel",
        "phone": "60120000000",
        "role": "Branch Manager / \u5206\u884c\u7ecf\u7406",
        "handles": [
          "complaints",
          "special_requests",
          "vip_customers",
          "policy_questions"
        ]
      },
      "operations_manager": {
        "name": "Daniel",
        "phone": "60120000000",
        "role": "Operations Manager / \u8425\u8fd0\u7ecf\u7406",
        "handles": [
          "system_issues",
          "booking_problems",
          "service_coordination"
        ]
      },
      "membership_coordinator": {
        "name": "Daniel",
        "phone": "60120000000",
        "role": "Membership Coordinator / \u4f1a\u5458\u534f\u8c03\u5458",
        "handles": [
          "membership_questions",
          "birthday_promotions",
          "points_system"
        ]
      },
      "customer_service_supervisor": {
        "name": "Daniel",
        "phone": "60120000000",
        "role": "Customer Service Supervisor / \u5ba2\u6237\u670d\u52a1\u4e3b\u7ba1",
        "handles": [
          "general_inquiries",
          "service_feedback",
          "booking_assistance"
        ]
      }
    }
  },
  "lead_tracking": {
    "enabled": true,
    "credentials_file": "config/<PUT_YOUR_GOOGLE_PROJECT_ID_HERE>-c123857bd130.json",
    "spreadsheet_name": "YOUR_GOOGLE_SHEET_ID",
    "auto_record_after_messages": 3,
    "use_ai_analysis": true,
    "log_lead_recording": true
  },
  "google_sheets_features": {
    "follow_up_system": {
      "enabled": true,
      "description": "Auto follow-up campaigns for leads (includes campaigns, queue, sent log, analytics). Saves 2 API reads per message when disabled.",
      "sheets": [
        "follow_up_campaigns",
        "follow_up_queue",
        "follow_up_sent_log",
        "follow_up_analytics"
      ]
    },
    "membership_system": {
      "enabled": true,
      "description": "Member registration and loyalty points system. Saves 1 API read per 5 minutes when disabled.",
      "sheets": [
        "members"
      ]
    },
    "conversation_history": {
      "enabled": true,
      "description": "Store and retrieve customer conversation history. Saves 1 API read per message when disabled.",
      "sheets": [
        "conversation_history"
      ]
    },
    "lead_tracking": {
      "enabled": true,
      "description": "Track customer leads and interactions. Saves 1 API read per message when disabled.",
      "sheets": [
        "customer_record"
      ]
    }
  },
  "memory": {
    "enabled": true,
    "max_conversations_stored": 20,
    "max_conversations_retrieved": 20,
    "save_conversation_summary": true,
    "extract_preferences": true,
    "tiered_detail": {
      "recent_detailed": 3,
      "medium_detail": 10,
      "brief_mention": 20
    }
  },
  "anti_spam": {
    "rate_limit": {
      "enabled": true,
      "max_messages_per_minute": 10,
      "max_messages_per_hour": 100,
      "burst_window_seconds": 60,
      "burst_threshold": 5
    },
    "flood_detection": {
      "enabled": true,
      "duplicate_threshold": 3,
      "duplicate_window_seconds": 60,
      "similarity_threshold": 0.8
    },
    "cooldown": {
      "enabled": true,
      "min_seconds_between_messages": 2,
      "escalate_cooldown_after_violations": true,
      "max_cooldown_seconds": 30
    },
    "blocking": {
      "enabled": true,
      "auto_block_after_violations": 5,
      "block_duration_minutes": 5,
      "warning_threshold": 3
    },
    "whitelist": [],
    "blacklist": []
  },
  "menu_image": {
    "enabled": true,
    "send_for_keywords": [
      "\u6240\u6709menu",
      "\u6240\u6709\u4ef7\u683c",
      "\u5168\u90e8\u9879\u76ee",
      "\u4ef7\u683c\u8868",
      "full menu",
      "all prices",
      "complete pricing",
      "show me everything",
      "\u6709\u4ec0\u4e48\u914d\u5957",
      "latest menu",
      "\u6700\u65b0\u4ef7\u683c",
      "menu",
      "\u4ef7\u76ee\u8868"
    ],
    "caption_chinese": "",
    "caption_english": "",
    "chinese_file_path": "/root/reflexology-agent(token-optimized)/web/static/menu/menu_chinese.png",
    "english_file_path": "/root/reflexology-agent(token-optimized)/web/static/menu/menu_english.png"
  },
  "video_processing": {
    "enabled": true,
    "keyframes_to_extract": 3,
    "max_frame_resolution": 1024,
    "supported_formats": [
      "mp4",
      "mov",
      "avi",
      "webm",
      "mkv",
      "flv",
      "3gp",
      "mpeg",
      "mpg"
